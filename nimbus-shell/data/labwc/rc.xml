<?xml version="1.0"?>
<!-- Nimbus Desktop compositor settings (labwc). Copied to
     ~/.config/nimbus/labwc on first login; edit that copy freely. -->
<labwc_config>

  <core>
    <gap>6</gap>
  </core>

  <theme>
    <name>Nimbus</name>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>11</size></font>
  </theme>

  <placement>
    <policy>cascade</policy>
  </placement>

  <snapping>
    <range>12</range>
    <topMaximize>yes</topMaximize>
  </snapping>

  <keyboard>
    <default />

    <!-- Tap Super to open the launcher -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="nimbus-shell launcher" />
    </keybind>
    <keybind key="W-space"><action name="Execute" command="nimbus-shell launcher" /></keybind>

    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-e"><action name="Execute" command="thunar" /></keybind>
    <keybind key="W-b"><action name="Execute" command="firefox" /></keybind>
    <keybind key="W-i"><action name="Execute" command="nimbus-shell settings" /></keybind>
    <keybind key="W-x"><action name="Execute" command="nimbus-shell power" /></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -f -c 16161e" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>

    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>

    <keybind key="Print">
      <action name="Execute" command="sh -c 'mkdir -p ~/Pictures &amp;&amp; grim ~/Pictures/screenshot-$(date +%F-%H%M%S).png'" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="sh -c 'mkdir -p ~/Pictures &amp;&amp; grim -g &quot;$(slurp)&quot; ~/Pictures/screenshot-$(date +%F-%H%M%S).png'" />
    </keybind>

    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set +5%" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
    </device>
  </libinput>

</labwc_config>
