# Maintainer: Nimbus <https://github.com/p1e2r/nimbus-os>
# Calamares is not in the official Arch repos, so Nimbus builds it here.
pkgname=calamares
pkgver=3.3.14
pkgrel=2
pkgdesc="Distribution-independent graphical installer framework (Nimbus build)"
arch=('x86_64')
url="https://calamares.io"
license=('GPL-3.0-or-later')
depends=(
  'qt6-base' 'qt6-svg' 'qt6-declarative' 'qt6-wayland' 'qt6-translations'
  'kcoreaddons' 'kconfig' 'ki18n' 'kwidgetsaddons' 'solid' 'kpmcore'
  'polkit-qt6' 'yaml-cpp' 'python' 'python-yaml' 'python-jsonschema'
  'libpwquality' 'icu' 'squashfs-tools' 'rsync'
)
options=('!debug')
makedepends=('cmake' 'extra-cmake-modules' 'qt6-tools' 'ninja')
source=("https://github.com/calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz")
sha256sums=('5547f80db067dea923ae693ba6bb88eb2b2eeac1da3ebec42fce453e31c290c0')

build() {
  cmake -S "calamares-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_QT6=ON \
    -DINSTALL_CONFIG=ON \
    -DBUILD_TESTING=OFF \
    -DBUILD_SCHEMA_TESTING=OFF \
    -DBUILD_CRASH_REPORTING=OFF \
    -DWITH_APPSTREAM=OFF \
    -DWITH_PYTHONQT=OFF \
    -DSKIP_MODULES="dracut dracutlukscfg dummycpp dummyprocess dummypython dummypythonqt initramfs initramfscfg interactiveterminal license mkinitfs openrcdmcryptcfg plymouthcfg plasmalnf services-openrc tracking webview zfs zfshostid"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # Nimbus starts the installer through nimbus-install (as root); the stock
  # launcher entry would run it unprivileged and fail.
  rm -f "$pkgdir/usr/share/applications/calamares.desktop"
}
