#!/bin/sh
# Makes the system identify as Nimbus (boot messages, login prompt,
# neofetch & co.). Run by a pacman hook whenever the "filesystem" package,
# which owns these files, is installed or upgraded.

tmp=/etc/.os-release.nimbus
cat > "$tmp" <<'OS'
NAME="Nimbus"
PRETTY_NAME="Nimbus"
ID=nimbus
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;90;169;255"
HOME_URL="https://github.com/p1e2r/nimbus-os"
DOCUMENTATION_URL="https://github.com/p1e2r/nimbus-os#readme"
SUPPORT_URL="https://github.com/p1e2r/nimbus-os/issues"
BUG_REPORT_URL="https://github.com/p1e2r/nimbus-os/issues"
LOGO=nimbus-logo
OS
chmod 644 "$tmp"
mv -f "$tmp" /etc/os-release

printf 'Nimbus \\r (\\l)\n\n' > /etc/issue
