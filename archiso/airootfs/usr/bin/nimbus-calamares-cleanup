#!/bin/bash
# Called by the installer right after the live image was copied to $1.
# Turns that copy into a normal installed system.
set -uo pipefail
ROOT="${1:?usage: nimbus-calamares-cleanup ROOT}"
[ -d "$ROOT/usr" ] || { echo "not a root filesystem: $ROOT" >&2; exit 1; }

# 1. Remove files that only make sense on the live ISO.
list=${NIMBUS_LIVE_LIST:-/usr/share/nimbus/live-only-files}
if [ -f "$list" ]; then
    while IFS= read -r f; do
        case "$f" in ''|'#'*) continue ;; esac
        rm -rf -- "${ROOT:?}/${f#/}"
    done < "$list"
fi
rm -f "$ROOT/usr/share/nimbus/live-only-files"
# The plain labwc session is confusing next to "Nimbus" (same compositor).
rm -f "$ROOT/usr/share/wayland-sessions/labwc.desktop"

# 2. Kernel (mkarchiso empties /boot inside the image). Microcode is
#    embedded into the initramfs by mkinitcpio's "microcode" hook.
for d in "$ROOT"/usr/lib/modules/*/; do
    if [ "$(cat "$d/pkgbase" 2>/dev/null)" = "linux" ]; then
        install -Dm644 "$d/vmlinuz" "$ROOT/boot/vmlinuz-linux"
    fi
done

# 3. A normal mkinitcpio preset (the live one builds an archiso initramfs).
mkdir -p "$ROOT/etc/mkinitcpio.d"
cat > "$ROOT/etc/mkinitcpio.d/linux.preset" <<'PRESET'
# mkinitcpio preset file for the 'linux' package
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
PRESET

# 4. DNS inside the chroot, so the "packages" step can download the chosen
#    desktop. The live /etc/resolv.conf points at systemd-resolved; give the
#    target the real upstream servers. NetworkManager replaces this file on
#    the installed system's first boot.
rm -f "$ROOT/etc/resolv.conf"
if [ -s /run/systemd/resolve/resolv.conf ]; then
    cp /run/systemd/resolve/resolv.conf "$ROOT/etc/resolv.conf"
else
    cp -L /etc/resolv.conf "$ROOT/etc/resolv.conf" 2>/dev/null || true
fi

# 5. Mirrors from the live session, and a fresh pacman keyring.
if grep -q '^Server' /etc/pacman.d/mirrorlist 2>/dev/null; then
    cp /etc/pacman.d/mirrorlist "$ROOT/etc/pacman.d/mirrorlist"
else
    echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' > "$ROOT/etc/pacman.d/mirrorlist"
fi
rm -rf "$ROOT/etc/pacman.d/gnupg"
chroot "$ROOT" pacman-key --init
chroot "$ROOT" pacman-key --populate archlinux nimbus
# gpg-agent would otherwise keep the target busy and break unmounting.
chroot "$ROOT" gpgconf --homedir /etc/pacman.d/gnupg --kill all 2>/dev/null || true

# 6. The live user's sudo rule is created at boot, but be thorough.
rm -f "$ROOT/etc/sudoers.d/10-live"
exit 0
